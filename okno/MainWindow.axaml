<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="okno.MainWindow"
        Title="Mój warsztat"
        Width="800"
        Height="500"
        Background="LightBlue">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
        <TextBlock Text="Warsztat" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" FontWeight="Bold" />
        <TextBlock Text="Moja pierwsza aplikacja" HorizontalAlignment="Center" Foreground="DarkGray" />
        <Button Content="Start" HorizontalAlignment="Center" CornerRadius="5" />
        <TextBox Watermark="Wpisz swoje imię" Width="220" />
        <TextBlock Text="Miło Cię widzieć!" Foreground="DarkBlue" FontSize="18" HorizontalAlignment="Center" />
    </StackPanel>
</Window>
